# Resend API key — get free at https://resend.com
# Add this in Vercel: Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender on a domain verified in Resend (Domains). Needed for the confirmation copy to the person
# who wrote; without it only the notification to Matthew is sent.
RESEND_FROM="Matthew Grygar <kontakt@matthewgrygar.com>"
